named = Go to <span data-l10n-name="place">the tower</span> now.
# Translators may reorder named elements; ids and classes come from the source.
named-order = At <i data-l10n-name="where">the gate</i> waits <b data-l10n-name="who">Ada</b>.
# No source element of that name, or of that tag: plain text.
named-missing = A <span data-l10n-name="ghost">ghost</span> name.
named-mismatch = Wrong <i data-l10n-name="tag">tag</i> here.
# Each source element can be used once; the second reference is plain text.
named-twice = <span data-l10n-name="once">first</span> and <span data-l10n-name="once">second</span>
box = Container text
box-markup = Mixed <b>bold</b> text
inline = translated
inline-args =
    { $n ->
        [one] one item
       *[other] { $n } items
    }
